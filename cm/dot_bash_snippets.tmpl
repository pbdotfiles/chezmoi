#--- Add a "tempwork" command that creates a temporary directory that will be automatically deleted after exit.
tempwork() {
  local tdir
  tdir=$(mktemp -d)
  # Open a new sub-shell inside the temp directory
  (
    cd "$tdir" || return
    echo "Entering temporary workspace: $tdir"
    echo "This directory will be deleted when you type 'exit'."
    $SHELL
    rm -rf "$tdir"
    echo "Workspace $tdir deleted."
  )
}


#--- Tmux utility
# Create, attach, or switch to a tmux session by name from both inside or outside tmux.
# Usage: tm <session-name>

tm() {
  # 1. Check if a session name was provided
  if [ -z "$1" ]; then
    echo "Usage: tm <session-name>"
    return 1
  fi

  # 2. Check if the session already exists
  tmux has-session -t "$1" 2>/dev/null
  local session_exists=$?

  # 3. Create the session if it doesn't exist
  if [ $session_exists -ne 0 ]; then
    tmux new-session -d -s "$1"
    echo "Created new session: $1"
  fi

  # 4. Logic for switching/attaching
  if [ -n "$TMUX" ]; then
    # We are INSIDE tmux
    local current_session=$(tmux display-message -p '#S')

    if [ "$current_session" = "$1" ]; then
      echo "You are already in session: $1"
    else
      tmux switch-client -t "$1"
    fi
  else
    # We are OUTSIDE tmux
    tmux attach-session -t "$1"
  fi
}

# Add tab autocomplete for the "tm" command
_tm_completion() {
    local cur=${COMP_WORDS[COMP_CWORD]}
    # Get list of sessions, removing the trailing colon from tmux output
    local sessions=$(tmux list-sessions -F "#S" 2>/dev/null)
    COMPREPLY=( $(compgen -W "$sessions" -- "$cur") )
}
complete -F _tm_completion tm

#--- lf utility
# Press 'q' to exit and stay in the same directory.
# Press 'Shift-q' to exit and remain in the original directory.
function lf() {
	local tmp="$(mktemp -t "lf-cwd.XXXXXX")"
	export LF_CWD_FILE="$tmp"
	command lf "$@"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

#--- Repomix utilities
{{- $features := dig .chezmoi.hostname (dict) .hosts_features }}
# Interactive file selection with yazi, packed to the clipboard.
# One saved selection per launch folder, under the XDG state dir.
#   repomix-pick  pick files/folders, save the selection, pack it
#   repomix-load  repack the saved selection for this folder
#   repomix-all   pack the whole current folder

# Where the selection for the current folder is stored.
_repomix_sel() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/repomix"
  mkdir -p "$dir" || return 1
  local key
  key=$(printf '%s' "$PWD" | sha256sum | cut -c1-16) || return 1
  printf '%s/%s.selection\n' "$dir" "$key"
}

# Send stdin to the clipboard.
_repomix_copy() {
{{- if (dig "runs_within_wsl" false $features) }}
  win32yank.exe -i
{{- else }}
  xclip -selection clipboard >/dev/null 2>&1
{{- end }}
}

# Pack the paths listed in file $1 and copy the result to the clipboard.
_repomix_pack() {
  npx -y repomix --stdin --stdout --no-file-summary < "$1" | _repomix_copy
}

# Pick files and/or folders with yazi, save the selection, then pack it.
repomix-pick() {
  local sel tmp
  sel=$(_repomix_sel) || return 1
  tmp=$(mktemp) || return 1

  yazi --chooser-file="$tmp"

  if [ -s "$tmp" ]; then
    sort -u "$tmp" > "$sel"
    rm -f "$tmp"
    echo "Saved $(wc -l < "$sel") paths to $sel"
    _repomix_pack "$sel"
  else
    rm -f "$tmp"
    echo "No selection; keeping the previous one." >&2
    return 1
  fi
}

# Pack the saved selection for this folder without reselecting.
repomix-load() {
  local sel
  sel=$(_repomix_sel) || return 1
  if [ ! -s "$sel" ]; then
    echo "No saved selection for $PWD (run repomix-pick)." >&2
    return 1
  fi
  _repomix_pack "$sel"
}

# Pack the whole current folder.
repomix-all() {
  npx -y repomix --stdout --no-file-summary | _repomix_copy
}
