#--- Named Pixi Environments Manager (In-Place Mutation Edition)
# Environments live in ~/.pixi_envs/<name> and are activated in the current shell.
# Install packages with `pe add <name> <pkg>`, or `pixi add --manifest-path
# "$PIXI_PROJECT_MANIFEST" <pkg>` once active. Plain `pixi add` is not enough: in a folder
# with its own pixi.toml (or pyproject.toml), pixi targets that project instead.
# In a folder whose .envrc uses `use pe <name>` (see ~/.config/direnv/direnvrc),
# direnv owns the environment: pe records the choice for that folder in the current
# shell and lets direnv apply it, so leaving the folder undoes it cleanly.
# Usage: pe <command> [args]

PE_ENVS_DIR="$HOME/.pixi_envs"

_pe_check_name() {
  if [[ ! "$1" =~ ^[A-Za-z0-9._-]+$ ]] || [ ! -f "$PE_ENVS_DIR/$1/pixi.toml" ]; then
    echo "❌ Environment '$1' does not exist." >&2
    return 1
  fi
}

_pe_activate() {
  _pe_check_name "$1" || return 1
  local _pe_name="$1" _pe_hook

  # Build the hook from the environment as it would be with nothing active, so the
  # current environment stays untouched if pixi fails.
  _pe_hook="$(
    [ -n "${PE_ACTIVE:-}" ] && eval "$_PE_RESTORE"
    pixi shell-hook --manifest-path "$PE_ENVS_DIR/$_pe_name" --change-ps1 false
  )" || return 1
  [ -n "${PE_ACTIVE:-}" ] && _pe_deactivate >/dev/null

  # Record every exported variable the hook adds, changes or removes, so deactivating
  # (or switching to another environment) restores exactly the previous state.
  local -A _pe_before=()
  local _pe_v _pe_restore=""
  for _pe_v in $(compgen -e); do _pe_before[$_pe_v]="${!_pe_v}"; done
  eval "$_pe_hook"
  # The hook's pixi() wrapper re-runs the hook behind our back after `pixi add`.
  unset -f pixi 2>/dev/null
  for _pe_v in $(compgen -e); do
    if [[ ! -v _pe_before[$_pe_v] ]]; then
      _pe_restore+="unset $_pe_v;"
    elif [[ "${_pe_before[$_pe_v]}" != "${!_pe_v}" ]]; then
      _pe_restore+="export $_pe_v=$(printf '%q' "${_pe_before[$_pe_v]}");"
    fi
  done
  for _pe_v in "${!_pe_before[@]}"; do
    if [[ ! -v $_pe_v ]]; then
      _pe_restore+="export $_pe_v=$(printf '%q' "${_pe_before[$_pe_v]}");"
    fi
  done

  # Exported so that child shells can deactivate too.
  export _PE_RESTORE="$_pe_restore" PE_ACTIVE="$_pe_name"
  hash -r
}

_pe_deactivate() {
  if [ -z "${PE_ACTIVE:-}" ]; then
    echo "❌ No active environment to deactivate." >&2
    return 1
  fi
  eval "$_PE_RESTORE"
  unset _PE_RESTORE PE_ACTIVE
  hash -r
  echo "💤 Environment deactivated."
}

_pe_in_direnv() {
  [ -n "${PE_DIRENV_DIR:-}" ] && command -v direnv >/dev/null
}

# Re-evaluate .envrc now, in this shell only: direnv reloads when its watch list is gone.
# DIRENV_WATCHES is an undocumented direnv internal (works with direnv 2.38). If switching
# inside a direnv folder stops applying after a direnv upgrade, look here first.
# (`direnv reload` is not a substitute: it touches .envrc, affecting every shell, and only
# once per second because watch times have 1-second precision.)
_pe_direnv_reload() {
  unset DIRENV_WATCHES
  eval "$(direnv export bash)"
}

# Record which environment ($1, or "none") this shell uses in the current direnv folder.
_pe_direnv_switch() {
  local _pe_entry _pe_new=""
  while IFS= read -r _pe_entry; do
    if [ -n "$_pe_entry" ] && [ "${_pe_entry%=*}" != "$PE_DIRENV_DIR" ]; then
      _pe_new+="$_pe_entry"$'\n'
    fi
  done <<<"${PE_OVERRIDES:-}"
  if [ "$1" != "$PE_DIRENV_DEFAULT" ]; then
    _pe_new+="$PE_DIRENV_DIR=$1"$'\n'
  fi
  if [ -n "$_pe_new" ]; then export PE_OVERRIDES="$_pe_new"; else unset PE_OVERRIDES; fi
  _pe_direnv_reload
}

pe() {
  local cmd="${1:-}"
  case "$cmd" in
  list | ls)
    local manifest name
    for manifest in "$PE_ENVS_DIR"/*/pixi.toml; do
      [ -f "$manifest" ] || continue
      name="${manifest%/pixi.toml}"
      name="${name##*/}"
      if [ "$name" = "${PE_ACTIVE:-}" ]; then echo "* $name"; else echo "  $name"; fi
    done
    ;;
  create)
    if [ -z "${2:-}" ]; then
      echo "Usage: pe create <env_name> [package ...]"
      return 1
    fi
    if [[ ! "$2" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "❌ Invalid environment name '$2'."
      return 1
    fi
    local target="$PE_ENVS_DIR/$2"
    if [ -e "$target" ]; then
      echo "❌ Environment '$2' already exists."
      return 1
    fi
    pixi init "$target" || return 1
    if [ $# -gt 2 ]; then
      pixi add --manifest-path "$target" "${@:3}" || return 1
    fi
    echo "✅ Created environment '$2'."
    ;;
  activate | shell)
    if [ -z "${2:-}" ]; then
      echo "Usage: pe activate <env_name>"
      return 1
    fi
    if _pe_in_direnv; then
      _pe_check_name "$2" && _pe_direnv_switch "$2"
    else
      _pe_activate "$2"
    fi
    ;;
  deactivate)
    if [ -z "${PE_ACTIVE:-}" ]; then
      echo "❌ No active environment to deactivate." >&2
      return 1
    fi
    if _pe_in_direnv; then
      _pe_direnv_switch none && echo "💤 Environment deactivated."
    else
      _pe_deactivate
    fi
    ;;
  add | remove)
    if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
      echo "Usage: pe $cmd <env_name> <package1> [package2 ...]"
      return 1
    fi
    _pe_check_name "$2" || return 1
    pixi "$cmd" --manifest-path "$PE_ENVS_DIR/$2" "${@:3}" || return 1
    # Re-run the hook so activation variables of new packages apply right away.
    if [ "${PE_ACTIVE:-}" = "$2" ]; then
      if _pe_in_direnv; then _pe_direnv_reload; else _pe_activate "$2"; fi
    fi
    ;;
  *)
    echo "Pixi Environment Manager"
    echo "Usage:"
    echo "  pe list                       List all environments (* = active)"
    echo "  pe create <name> [pkgs...]    Create a new environment"
    echo "  pe activate <name>            Activate or switch environment (alias: pe shell)"
    echo "  pe deactivate                 Deactivate the active environment"
    echo "  pe add <name> <pkgs...>       Add packages (pixi add options work, e.g. --pypi)"
    echo "  pe remove <name> <pkgs...>    Remove packages"
    echo
    echo "Inside an active environment: pixi add --manifest-path \"\$PIXI_PROJECT_MANIFEST\" <pkg>"
    echo "(plain 'pixi add' targets the current folder's own pixi project, if it has one)."
    ;;
  esac
}

_pe_completion() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local prev=${COMP_WORDS[COMP_CWORD - 1]}

  if [[ "$COMP_CWORD" -eq 2 && ("$prev" == "shell" || "$prev" == "activate" || "$prev" == "add" || "$prev" == "remove") ]]; then
    local envs=""
    [ -d "$PE_ENVS_DIR" ] && envs=$(ls -1 "$PE_ENVS_DIR" 2>/dev/null)
    COMPREPLY=($(compgen -W "$envs" -- "$cur"))
  elif [[ "$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=($(compgen -W "list create shell activate deactivate add remove" -- "$cur"))
  fi
}
complete -F _pe_completion pe
