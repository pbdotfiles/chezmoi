{
  "$schema": "https://opencode.ai/v2/cli.json",
  // System notifications and sounds when a session needs attention or finishes.
  // Sounds play on the machine running the TUI, so they are silent over SSH.
  "attention": {
    "notifications": true,
    "sound": true
  },
  // No session tab strip: tmux windows hold the sessions instead.
  "tabs": {
    "mode": "off"
  },
  // Home/End move within the visible (wrapped) prompt row instead of jumping to the
  // first/last message. The transcript keeps Ctrl+G / Alt+Home and Ctrl+Alt+G.
  "keybinds": {
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.visual.line.home": "alt+a,home",
    "input.visual.line.end": "alt+e,end"
  },
  "session": {
    "sidebar": "hide"
  },
}
