{
  "$schema": "https://opencode.ai/config.json",

  // Uses EXA_API_KEY when set (Bitwarden hosts), Exa's anonymous tier otherwise.
  "websearch": { "provider": "exa" },

  // The review-plan skill writes plans to OpenCode's plan directory, outside the project.
  "permissions": [
    { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      // One-time manual step on each machine: npx @playwright/mcp install-browser chrome-for-testing
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--caps=vision,devtools",
          "--browser=chromium"
        ],
        "disabled": true
      }
    }
  },

  "plugins": ["@ex-machina/opencode-anthropic-auth@next"]
}
