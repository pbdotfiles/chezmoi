#!/bin/bash

{{ include ".chezmoitemplates/pause_on_error" }}

set -euo pipefail

{{ include ".chezmoitemplates/sudo_keepalive" }}
sudo_keepalive

echo "🤖 Configuring Claude Pro keepalive (scheduled 5h window pings via OpenCode + Haiku 5.5)..."

USERNAME="{{ .chezmoi.username }}"
OPENCODE_BIN="$HOME/.opencode/bin/opencode"

# 1. Install OpenCode (official installer, user space, stable path independent of nvm)
if [ ! -x "$OPENCODE_BIN" ]; then
    echo "   -> Installing OpenCode..."
    curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
else
    echo "   -> OpenCode already installed, skipping."
fi

# 2. Working directory for the ping sessions (keeps them out of other projects)
mkdir -p "$HOME/.local/share/claude-keepalive"

# 3. Create the ping script
echo "   -> Creating ping script at /usr/local/bin/claude-keepalive..."
cat << 'EOF' | sudo tee /usr/local/bin/claude-keepalive > /dev/null
#!/bin/bash
# Start a Claude Pro 5h usage window with a minimal Haiku prompt through OpenCode.
set -euo pipefail

OPENCODE_BIN="$HOME/.opencode/bin/opencode"

# Reinstall OpenCode if it disappeared since the last chezmoi apply
if [ ! -x "$OPENCODE_BIN" ]; then
    echo "OpenCode not found at $OPENCODE_BIN, installing..."
    curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
fi

# Force subscription auth (OAuth account), never API billing
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN

# --standalone: private server that exits with the command, no lingering service
timeout 120 "$OPENCODE_BIN" run --standalone \
    -m anthropic/claude-haiku-5-5 "Reply with exactly: pong"
EOF

sudo chmod +x /usr/local/bin/claude-keepalive

# 4. Create the systemd service
echo "   -> Creating systemd service..."
cat << EOF | sudo tee /etc/systemd/system/claude-keepalive.service > /dev/null
[Unit]
Description=Ping Claude (OpenCode + Haiku) to start a 5h usage window
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=$USERNAME
WorkingDirectory=$HOME/.local/share/claude-keepalive
ExecStart=/usr/local/bin/claude-keepalive
EOF

# 5. Create the systemd timer
# Chain anchored on an evening switch at 22:15: windows end at ~07:12, 12:13,
# 17:14 and 22:15. Minutes are staggered so a ping never lands while the
# previous window is still open. 22:15 -> 02:12 is left uncovered (night).
echo "   -> Creating systemd timer..."
cat << 'EOF' | sudo tee /etc/systemd/system/claude-keepalive.timer > /dev/null
[Unit]
Description=Start Claude 5h usage windows at fixed times

[Timer]
OnCalendar=*-*-* 02:12:00
OnCalendar=*-*-* 07:13:00
OnCalendar=*-*-* 12:14:00
OnCalendar=*-*-* 17:15:00
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
EOF

# 6. Enable and start the timer
echo "   -> Reloading systemd and enabling timer..."
sudo systemctl daemon-reload
sudo systemctl enable --now claude-keepalive.timer

# 7. The Claude Pro OAuth login is a one-time interactive step (tokens then refresh on their own)
if ! "$OPENCODE_BIN" auth list --standalone 2>/dev/null | grep -qi '^anthropic'; then
    echo "⚠️  OpenCode has no Anthropic account yet. Log in once (choose the Claude Pro/Max OAuth method):"
    echo "      $OPENCODE_BIN auth login anthropic"
fi

echo "✅ Claude keepalive scheduled via systemd."
