# =============================================================================
# .pbenv.sh files are no longer read: per-folder environments now use direnv
# (`use pe <name>` in an .envrc). On shell startup, warn if a .pbenv.sh exists in
# the current folder or a parent, without executing it.
# =============================================================================

_warn_obsolete_pbenv() {
  local search_dir="$PWD"
  while :; do
    if [ -f "$search_dir/.pbenv.sh" ]; then
      printf '\033[1;97;41m WARNING: THERE IS A .pbenv.sh BUT NOTHING READS IT ANYMORE \033[0m\n'
      printf '\033[1;31m %s was NOT executed. Move its content to an .envrc (e.g. `use pe <name>`), then run `direnv allow`.\033[0m\n' "$search_dir/.pbenv.sh"
      return 0
    fi
    [ -z "$search_dir" ] && return 0
    search_dir="${search_dir%/*}"
  done
}

_warn_obsolete_pbenv
unset -f _warn_obsolete_pbenv
